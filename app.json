{
  "expo": {
    "name": "BeSeen",
    "slug": "beseen",
    "owner": "edu-afk11",
    "version": "0.1.0",
    "scheme": "beseen",
    "icon": "./assets/app-icon-store-1024.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9F5",
    "splash": {
      "image": "./assets/app-icon-foreground-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#F98F73"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "BeSeen uses your outfit photo only when you activate Street Mode.",
          "cameraPermission": "BeSeen needs camera access to photograph your outfit.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BeSeen uses your location only while Street Mode is active.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F98F73",
          "defaultChannel": "matches",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.beseen.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BeSeen uses your location only while Street Mode is active.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.beseen.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-foreground-1024.png",
        "backgroundColor": "#F98F73"
      },
      "splash": {
        "image": "./assets/app-icon-foreground-1024.png",
        "resizeMode": "contain",
        "backgroundColor": "#F98F73"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "beseen",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "eaeebaa3-ade8-4b24-adbf-9ffb4e0922c9"
      }
    }
  }
}
